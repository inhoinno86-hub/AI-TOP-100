# Reasoning provider configuration (copy to .env and `set -a; . ./.env; set +a`).
# Never put a key value in a committed file: AITOP_REASONER_API_KEY_ENV names the variable that holds it.

# provider kind or preset: nvidia-nim | openai | openai-compat | claude-cli
AITOP_REASONER_PROVIDER=nvidia-nim
AITOP_REASONER_MODEL=nvidia/nemotron-3-super-120b-a12b
# AITOP_REASONER_BASE_URL=https://integrate.api.nvidia.com/v1
AITOP_REASONER_API_KEY_ENV=NVIDIA_API_KEY
# json_schema (native constrained decoding) | json_object | prompt
AITOP_REASONER_STRUCTURED_MODE=json_schema
AITOP_REASONER_TIMEOUT=240
AITOP_REASONER_TEMPERATURE=0.2
AITOP_REASONER_MAX_TOKENS=8192

# The key itself (set in your shell / secret store, not here):
# NVIDIA_API_KEY=
# OPENAI_API_KEY=
